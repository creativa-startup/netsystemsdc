rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to content for the Landing Page
    match /content/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public read for solutions list
    match /solutions/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public read for SEO settings
    match /settings_seo/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public read for general settings (Landing page config)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public creation of leads (contact form)
    match /leads/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Allow public read for blog posts
    match /blog_posts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public access to chats for support widget
    match /chats/{chatId} {
      allow create: if true;
      allow read, update: if true; // In production, refine this to authorize specificIDs
      
      match /messages/{messageId} {
        allow read, create: if true;
      }
    }
    
    // Allow admin access to everything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
